# Postgres 16 + PostGIS + pgvector (для sparsevec нужен pgvector >= 0.7).
# База содержит PGDG-репозиторий, ставим pgvector оттуда.
#
# imresamu/postgis — мультиарх-сборка тех же образов PostGIS. Официальный
# postgis/postgis:16-3.4 существует ТОЛЬКО под amd64, и на Apple Silicon Docker
# гонял его полной эмуляцией QEMU (UseVirtualizationFramework=False, то есть без
# Rosetta): отсюда и медленные гео-запросы, и, по всей видимости, случайная
# гибель бэкендов на длинных прогонах. Тег обязан оставаться мультиарх — при
# возврате на postgis/postgis эмуляция вернётся молча.
FROM imresamu/postgis:16-3.4
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-16-pgvector \
    && rm -rf /var/lib/apt/lists/*
