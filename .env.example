DB_DSN=postgresql://habitus:habitus@localhost:5544/habitus
CITY_REGION_CODE=3
POI_RADIUS_M=500
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
DATA_DIR=./data
KAGGLE_USERNAME=
KAGGLE_KEY=

# Comma/newline-separated residential or mobile proxy URLs for cian-parser.
# Ими же ходит импорт объявления в личном кабинете: без прокси Циан отдаёт 403
# и капчу. Формат: http://user:pass@host:port или socks5://host:port.
# Keep credentials only in your local .env, never in this example or Git.
CIAN_PROXIES=

# Frontend map. Restrict the API key to approved website referrers and to
# Maps JavaScript API in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Online integrations. Copy this file to .env and never commit real keys.
OPENROUTER_API_KEY=
# Маршруты и изохроны (OpenRouteService).
# Публичный api.openrouteservice.org требует ключ с openrouteservice.org/dev.
# Свой инстанс ключа не требует — вместо ключа задайте ORS_BASE_URL, например
#   ORS_BASE_URL=http://ors:8082/ors
# Без обоих продукт работает: плечи маршрутов считаются по прямой и честно
# помечаются estimated, а источник блока приезжает с kind: "proxy".
ORS_API_KEY=
# ORS_BASE_URL=https://api.openrouteservice.org
ML_DOSSIER_TIMEOUT_S=30
ML_OBJECT_ASK_TIMEOUT_S=45
# Бюджет потоковой генерации объяснения (отдельно от поиска).
ML_EXPLAIN_TIMEOUT_S=60

# Границы шлюза.
DB_MAX_CONNS=20
BODY_LIMIT_BYTES=1048576
SESSION_SWEEP_MINUTES=360

# --- Личный кабинет продавца ---
ML_OWNER_TIMEOUT_S=60
CIAN_FETCH_PER_MIN=6
OWNER_IMPORT_PER_HOUR=20
OWNER_AUTOPUBLISH=true
OWNER_PHOTO_MAX_MB=10
OWNER_PHOTO_MAX_COUNT=20
CIAN_REGION=1

# --- Латентность поиска ---
# Реранк (кросс-энкодер bge-reranker-v2-m3) занимает львиную долю времени
# поиска и линеен по числу пар. Вне CUDA он идёт на CPU, и на слабой машине
# пул в 40 пар — это десятки секунд: шлюз рвёт запрос и показывает ошибку,
# хотя ML честно досчитывает позже.
#
# RERANK_POOL_N_CPU — потолок пула на машине без CUDA. Замер
# docs/notes/rerank-pool-2026-08-18.md: на 25 recall@10 держится (0.34 против
# 0.34 у сотни), проседает только MRR (0.55 → 0.48). Если поиск всё равно не
# укладывается — снижайте дальше, но помните, что ниже 25 качество не мерено.
RERANK_POOL_N=40
RERANK_POOL_N_CPU=25
RERANK_MAX_LENGTH=256
# Бюджет шлюза на один поиск. Меньше суммы стадий ML — и живой успешный запрос
# будет обрываться по таймауту.
ML_SEARCH_TIMEOUT_S=120

# Гость: первый поиск без регистрации. Брошенные гости (без живой сессии)
# вычищаются вместе с чатами через GUEST_RETENTION_DAYS дней.
GUEST_RETENTION_DAYS=30
GUEST_SWEEP_MINUTES=720
# Отдельный потолок LLM-ручек для гостя — строго меньше RATE_LIMIT_LLM_PER_HOUR.
RATE_LIMIT_LLM_GUEST_PER_HOUR=5

# --- Partner API (B2B) ---
# Публичный контур для интеграций: /partner/v1 плюс страница документации
# на /docs. Выключенный контур не регистрирует ни одного маршрута — снаружи
# не видно даже, что он существует.
PARTNER_API_ENABLED=true
# Лимиты по умолчанию. Индивидуальные значения партнёра (колонки
# rate_limit_per_min / llm_limit_per_hour) перекрывают эти.
PARTNER_RATE_LIMIT_PER_MIN=120
# Отдельный, более скупой потолок на ручки, за каждой из которых стоит вызов
# модели: поиск, досье, вопрос по объекту.
PARTNER_LLM_PER_HOUR=60
# Сколько помнить ответ на Idempotency-Key: повтор после разрыва сети приходит
# секундами, а не сутками.
PARTNER_IDEMPOTENCY_TTL_HOURS=24
# Сохранённый поиск партнёра — рабочий контекст интеграции, а не архив.
PARTNER_SEARCH_TTL_DAYS=30
PARTNER_SWEEP_MINUTES=360
# Вебхуки: доставка событий в CRM партнёра.
PARTNER_WEBHOOK_TIMEOUT_S=10
PARTNER_WEBHOOK_POLL_S=15
PARTNER_WEBHOOK_BATCH=20
# ВНИМАНИЕ: true разрешает подписки на http:// и локальные адреса. Это дыра
# SSRF — партнёр заставит шлюз стучаться во внутреннюю сеть. Только локальная
# разработка.
PARTNER_WEBHOOK_ALLOW_INSECURE=false
# По нему собирается doc_url в конверте ошибки и адрес страницы документации.
PUBLIC_BASE_URL=http://localhost:8080

# --- Контроль выдачи доступа ---
# ОБЯЗАТЕЛЬНО при PARTNER_API_ENABLED=true — иначе шлюз не стартует.
# Перец, которым перчится хеш ключа API. В базе его нет: без него дамп базы
# не даёт ни рабочих ключей (нельзя вписать свой), ни возможности подобрать
# существующие offline. Сгенерировать:  openssl rand -hex 32
# Смена перца обнуляет ВСЕ выпущенные ключи — их придётся выпустить заново.
PARTNER_KEY_PEPPER=
# SHA-256 админ-токена, которым подтверждается право выдавать доступ.
# Хранится ХЕШЕМ: чтение конфига сервера не должно давать сам токен.
# Посчитать:  HABITUS_ADMIN_TOKEN=… go run ./cmd/partner hash-token
# Пусто — выдача доступа выключена совсем.
PARTNER_ADMIN_TOKEN_HASH=

# --- Адрес клиента за прокси ---
# Без них allowlist ключа за балансировщиком проверял бы адрес самого
# балансировщика, то есть не проверял бы ничего. Пусто — адрес берётся из
# сокета, заголовкам не верим.
TRUSTED_PROXIES=
PROXY_HEADER=
