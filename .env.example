DB_DSN=postgresql://habitus:habitus@localhost:5544/habitus
CITY_REGION_CODE=3
POI_RADIUS_M=500
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
DATA_DIR=./data
KAGGLE_USERNAME=
KAGGLE_KEY=

# Comma/newline-separated residential or mobile proxy URLs for cian-parser.
# Ими же ходит импорт объявления в личном кабинете: без прокси Циан отдаёт 403
# и капчу. Формат: http://user:pass@host:port или socks5://host:port.
# Keep credentials only in your local .env, never in this example or Git.
CIAN_PROXIES=

# Frontend map. Restrict the API key to approved website referrers and to
# Maps JavaScript API in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Online integrations. Copy this file to .env and never commit real keys.
OPENROUTER_API_KEY=
# Маршруты и изохроны (OpenRouteService).
# Публичный api.openrouteservice.org требует ключ с openrouteservice.org/dev.
# Свой инстанс ключа не требует — вместо ключа задайте ORS_BASE_URL, например
#   ORS_BASE_URL=http://ors:8080/ors
# Без обоих продукт работает: плечи маршрутов считаются по прямой и честно
# помечаются estimated, а источник блока приезжает с kind: "proxy".
ORS_API_KEY=
# ORS_BASE_URL=https://api.openrouteservice.org
ML_DOSSIER_TIMEOUT_S=30
ML_OBJECT_ASK_TIMEOUT_S=45
# Бюджет потоковой генерации объяснения (отдельно от поиска).
ML_EXPLAIN_TIMEOUT_S=60

# Границы шлюза.
DB_MAX_CONNS=20
BODY_LIMIT_BYTES=1048576
SESSION_SWEEP_MINUTES=360

# --- Личный кабинет продавца ---
ML_OWNER_TIMEOUT_S=60
CIAN_FETCH_PER_MIN=6
OWNER_IMPORT_PER_HOUR=20
OWNER_AUTOPUBLISH=true
OWNER_PHOTO_MAX_MB=10
OWNER_PHOTO_MAX_COUNT=20
CIAN_REGION=1

# --- Латентность поиска ---
# Реранк (кросс-энкодер bge-reranker-v2-m3) занимает львиную долю времени
# поиска и линеен по числу пар. Вне CUDA он идёт на CPU, и на слабой машине
# пул в 40 пар — это десятки секунд: шлюз рвёт запрос и показывает ошибку,
# хотя ML честно досчитывает позже.
#
# RERANK_POOL_N_CPU — потолок пула на машине без CUDA. Замер
# docs/notes/rerank-pool-2026-08-18.md: на 25 recall@10 держится (0.34 против
# 0.34 у сотни), проседает только MRR (0.55 → 0.48). Если поиск всё равно не
# укладывается — снижайте дальше, но помните, что ниже 25 качество не мерено.
RERANK_POOL_N=40
RERANK_POOL_N_CPU=25
RERANK_MAX_LENGTH=256
# Бюджет шлюза на один поиск. Меньше суммы стадий ML — и живой успешный запрос
# будет обрываться по таймауту.
ML_SEARCH_TIMEOUT_S=120

# Гость: первый поиск без регистрации. Брошенные гости (без живой сессии)
# вычищаются вместе с чатами через GUEST_RETENTION_DAYS дней.
GUEST_RETENTION_DAYS=30
GUEST_SWEEP_MINUTES=720
# Отдельный потолок LLM-ручек для гостя — строго меньше RATE_LIMIT_LLM_PER_HOUR.
RATE_LIMIT_LLM_GUEST_PER_HOUR=5
